{
  "$schema": "https://raw.githubusercontent.com/code-yeongyu/oh-my-openagent/dev/assets/omo.schema.json",

  // Balanced defaults for general development.
  // Tuned for reliability across diverse tasks without overspending.
  //
  // Model selection is TUI-native. Omit per-agent `model` / per-category `model`
  // to use the Global Model selected via OpenCode `/models` or the TUI sidebar
  // [Set Global Model] picker.
  //
  // Optionally set ONE global default for all agents (uncomment):
  // "default_model": "anthropic/claude-opus-5",
  //
  // Per-agent `agents.*.model` and per-category `categories.*.model` are
  // deprecated — omit to use the TUI Global Model / default_model. See
  // docs/reference/configuration.md#model-resolution.
  // Example of deprecated usage (do not use):
  // "sisyphus": { "model": "anthropic/claude-opus-5" } // deprecated

  "[opencode]": {
    "agents": {
      // Main orchestrator: handles delegation and drives tasks to completion
      // omit model -> uses TUI Global Model / default_model
      "sisyphus": {
        "prompt_append": "Delegate to category-routed subagents for focused work.",
      },

      // Deep autonomous worker: end-to-end implementation
      "hephaestus": {
        "prompt_append": "Explore thoroughly, then implement. Prefer small, testable changes.",
      },

      // Strategic planner: interview mode before execution
      "prometheus": {
        "prompt_append": "Always interview first. Validate scope before planning.",
      },

      // Architecture consultant: complex design and debugging
      "oracle": {
        "reasoning": "high",
      },

      // Documentation and code search
      "librarian": {},

      // Fast codebase exploration
      "explore": {},

      // Visual tasks: UI/UX, images, diagrams
      "multimodal-looker": {},

      // Plan consultant: reviews and improves plans
      "metis": {},

      // Critic and reviewer
      "momus": {},

      // Continuation and long-running task handler
      "atlas": {},

      // Lightweight task executor for simple jobs
      "sisyphus-junior": {},
    },

    "categories": {
      "quick": {},
      "unspecified-low": { "reasoning": "xhigh" },
      "unspecified-high": { "reasoning": "max" },
      "writing": { "reasoning": "low" },
      "visual-engineering": { "reasoning": "max" },
      "deep": { "reasoning": "medium" },
      "ultrabrain": { "reasoning": "xhigh" },
    },

    // Conservative concurrency for cost control
    "background_task": {
      "providerConcurrency": {
        "anthropic": 3,
        "openai": 3,
        "google": 5,
        "opencode": 10,
      },
    },

    "experimental": { "aggressive_truncation": true },
  },
}
